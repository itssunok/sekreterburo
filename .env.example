# Google Analytics (GA4) measurement ID.
# Not read at runtime by the site itself — this is a static site with no
# server. The value is instead stored as a GitHub Actions repo secret named
# GA_MEASUREMENT_ID (Settings → Secrets and variables → Actions) and gets
# substituted into the __GA_MEASUREMENT_ID__ placeholder in index.html and
# en/index.html during deploy, see .github/workflows/deploy.yml.
GA_MEASUREMENT_ID=G-XXXXXXXXXX
