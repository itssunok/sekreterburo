# Google Analytics (GA4) measurement ID.
# Not read at runtime by the site itself — this is a static site with no
# server. The value is instead stored as a Cloudflare Pages environment
# variable named GA_MEASUREMENT_ID (Project → Settings → Environment
# variables) and gets substituted into the __GA_MEASUREMENT_ID__ placeholder
# in index.html and en/index.html by build.sh, which Cloudflare Pages runs
# as the project's build command.
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Quote request form (functions/api/quote.js).
# These are read at request time by the Cloudflare Pages Function, so they're
# set the same way as above (Project → Settings → Environment variables) —
# never committed here as real values.

# API key from resend.dev, used to send the office notification + visitor
# auto-reply emails.
RESEND_API_KEY=re_XXXXXXXXXX

# Where the office notification email is sent. While sekreterburo.com isn't
# yet verified as a sending domain in Resend, this is pointed at a personal
# test inbox instead of info@sekreterburo.com — switch it once domain
# verification (step 2) is done.
QUOTE_NOTIFY_EMAIL=sun@sociablenerd.com

# Optional. Sender address for both emails. Defaults to Resend's shared
# sandbox sender (onboarding@resend.dev), which is fine for testing but will
# land in spam / get rejected for real use. Once sekreterburo.com is verified
# in Resend, set this to e.g. "Sekreter Büro <info@sekreterburo.com>".
RESEND_FROM_EMAIL=Sekreter Büro Website <onboarding@resend.dev>
